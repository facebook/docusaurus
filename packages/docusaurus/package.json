{
  "name": "@docusaurus/core",
  "description": "Easy to Maintain Open Source Documentation Websites",
  "version": "4.0.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "static site generator",
    "webpack",
    "documentation",
    "websites",
    "open source",
    "docusaurus"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus"
  },
  "bin": {
    "docusaurus": "bin/docusaurus.mjs"
  },
  "scripts": {
    "build": "tsc --build && copy-untyped-files",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --build --watch",
    "copy:watch": "copy-untyped-files --watch"
  },
  "bugs": {
    "url": "https://github.com/facebook/docusaurus/issues"
  },
  "dependencies": {
    "@docusaurus/babel": "workspace:*",
    "@docusaurus/bundler": "workspace:*",
    "@docusaurus/fs": "workspace:*",
    "@docusaurus/glob": "workspace:*",
    "@docusaurus/logger": "workspace:*",
    "@docusaurus/mdx-loader": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "@docusaurus/utils-common": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "@rspack/core": "catalog:",
    "@rspack/dev-server": "catalog:",
    "boxen": "^9.0.0",
    "cli-table3": "^0.6.5",
    "combine-promises": "catalog:",
    "commander": "catalog:",
    "detect-port": "^2.1.0",
    "escape-html": "catalog:",
    "eta": "catalog:",
    "execa": "catalog:",
    "html-tags": "^5.1.0",
    "leven": "^4.1.0",
    "lodash": "catalog:",
    "open": "^11.0.2",
    "p-map": "^7.0.8",
    "prompts": "catalog:",
    "react-helmet-async": "npm:@slorber/react-helmet-async@1.3.0",
    "react-loadable": "npm:@docusaurus/react-loadable@6.0.0",
    "react-loadable-ssr-addon-v5-slorber": "^1.0.3",
    "react-router": "^5.3.4",
    "react-router-config": "^5.1.1",
    "react-router-dom": "^5.3.4",
    "semver": "catalog:",
    "serve-handler": "^6.1.7",
    "tinypool": "^2.1.2",
    "tslib": "catalog:",
    "update-notifier": "^7.3.1",
    "webpack": "catalog:",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@total-typescript/shoehorn": "catalog:",
    "@types/escape-html": "catalog:",
    "@types/history": "catalog:",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-config": "catalog:",
    "@types/react-router-dom": "catalog:",
    "@types/serve-handler": "^6.1.4",
    "@types/update-notifier": "^6.0.8",
    "@types/webpack-env": "^1.18.8",
    "tree-node-cli": "catalog:",
    "utility-types": "catalog:"
  },
  "peerDependencies": {
    "@mdx-js/react": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=24.21"
  }
}
